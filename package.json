{
  "name": "ai-vision-sidebar",
  "version": "1.0.0",
  "description": "A Chrome Manifest V3 AI Vision extension for screenshot analysis in the Chrome Side Panel.",
  "license": "MIT",
  "keywords": [
    "chrome-extension",
    "manifest-v3",
    "ai",
    "vision",
    "openrouter",
    "openai",
    "typescript",
    "sidebar",
    "screenshot"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xbardia/extension-vision.git"
  },
  "homepage": "https://github.com/0xbardia/extension-vision#readme",
  "bugs": {
    "url": "https://github.com/0xbardia/extension-vision/issues"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "vite build",
    "verify:dist": "node scripts/verify-dist.mjs",
    "package": "node scripts/package-extension.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build && npm run verify:dist"
  },
  "dependencies": {
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/chrome": "^0.0.326",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "fake-indexeddb": "^6.0.0",
    "vitest": "^3.0.8",
    "yazl": "^3.3.1"
  }
}
